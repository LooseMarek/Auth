APP_ENV=development
PORT={{PORT}}
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# ── Email transport (Resend) ─────────────────────────────────────────────────
# Optional. When set, configure.swift uses the Resend HTTP API to send real
# emails instead of printing them to the server console.
#
# Sign up for a free API key at https://resend.com.
#
# Free-tier note: with RESEND_FROM_EMAIL=onboarding@resend.dev (the default),
# Resend only delivers to the email address registered with your Resend account.
# To send to any address, verify your own domain in the Resend dashboard and
# set RESEND_FROM_EMAIL to an address on that domain.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
