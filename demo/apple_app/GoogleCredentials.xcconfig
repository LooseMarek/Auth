// GoogleCredentials.xcconfig
//
// Replace the placeholder values below with your real credentials from
// GoogleService-Info.plist (Google Cloud Console or Firebase), then run:
//
//   git update-index --skip-worktree demo/apple_app/GoogleCredentials.xcconfig
//
// This tells git to stop tracking local changes to this file so your real
// credentials never appear in diffs or get accidentally committed.
//
// To undo (e.g. to commit a change to the placeholder or a comment):
//   git update-index --no-skip-worktree demo/apple_app/GoogleCredentials.xcconfig

GOOGLE_CLIENT_ID = REPLACE_WITH_REAL_GOOGLE_CLIENT_ID
REVERSED_GOOGLE_CLIENT_ID = REPLACE_WITH_REVERSED_GOOGLE_CLIENT_ID
