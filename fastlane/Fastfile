default_platform(:ios)

platform :ios do

  desc "Build and test the Swift package for iOS Simulator"
  lane :test do |options|
    destination = options[:destination] || "platform=iOS Simulator,name=iPhone 17 Pro"
    run_tests(
      package_path: ".",
      scheme: "Auth-Package",
      destination: destination,
      result_bundle: true
    )
  end

  desc "Record reference snapshots for iOS Simulator (CI use only)"
  lane :record_snapshots do |options|
    destination = options[:destination] || "platform=iOS Simulator,name=iPhone 17 Pro"
    run_tests(
      package_path: ".",
      scheme: "Auth-Package",
      destination: destination,
      result_bundle: true
    )
  end

  desc "Build and test the Demo app for iOS Simulator"
  lane :demo_ios_test do |options|
    destination = options[:destination] || "platform=iOS Simulator,name=iPhone 17 Pro"
    run_tests(
      project: "demo/apple_app/DemoAuth.xcodeproj",
      scheme: "DemoAuthDefault",
      destination: destination,
      result_bundle: true
    )
  end

end

platform :mac do

  desc "Build and test the Swift package for macOS"
  lane :test do |options|
    destination = options[:destination] || "platform=macOS"
    run_tests(
      package_path: ".",
      scheme: "Auth-Package",
      destination: destination,
      result_bundle: true
    )
  end

  desc "Record reference snapshots for macOS (CI use only)"
  lane :record_snapshots do |options|
    destination = options[:destination] || "platform=macOS"
    run_tests(
      package_path: ".",
      scheme: "Auth-Package",
      destination: destination,
      result_bundle: true
    )
  end

  desc "Build and test the Demo app for macOS"
  lane :demo_mac_test do |options|
    destination = options[:destination] || "platform=macOS"
    run_tests(
      project: "demo/apple_app/DemoAuth.xcodeproj",
      scheme: "DemoAuthDefault",
      destination: destination,
      result_bundle: true,
      xcargs: "CODE_SIGN_IDENTITY=\"\" CODE_SIGNING_REQUIRED=NO DEVELOPMENT_TEAM=\"\""
    )
  end

  desc "Build and test the Demo API"
  lane :demo_api_test do
    Dir.chdir("../demo/api") do
      sh("swift test")
    end
  end

end

